# Server environment variables
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=1d
PORT=5000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
API_BASE_URL=http://localhost:5000/api
FRONTEND_URL=http://localhost:5173

# Optional email config for contact form
EMAIL_SERVICE=smtp
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email_user
EMAIL_PASS=your_email_password

# GitHub integration
GITHUB_USERNAME=your_github_username
GITHUB_TOKEN=your_github_token

# Client environment variables
VITE_API_BASE_URL=http://localhost:5000/api
VITE_SITE_TITLE=Anish Kumar Ojha | Full Stack Developer
VITE_SITE_DESCRIPTION=Professional Full Stack Developer portfolio built with React, Three.js, Node.js, MongoDB and JWT authentication.
